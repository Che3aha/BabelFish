{
  "id":"/babel-fish-universal-translator-app-id-v1",
  "name":"Babel Fish Universal Translator",
  "short_name":"Babel Fish",
  "description":"Speak or type, translate into 130+ languages online, optionally download supported on-device language models, and read the result aloud.",
  "start_url":"./?pwa=babel-fish",
  "scope":"./",
  "display":"standalone",
  "orientation":"any",
  "background_color":"#080b12",
  "theme_color":"#080b12",
  "categories":["utilities","productivity","education"],
  "launch_handler":{"client_mode":"navigate-existing"},
  "prefer_related_applications":false,
  "icons":[
    {"src":"icon-192.png","sizes":"192x192","type":"image/png","purpose":"any"},
    {"src":"icon-512.png","sizes":"512x512","type":"image/png","purpose":"any"},
    {"src":"icon-maskable-512.png","sizes":"512x512","type":"image/png","purpose":"maskable"}
  ],
  "screenshots":[
    {"src":"screenshot-wide.png","sizes":"1280x720","type":"image/png","form_factor":"wide","label":"Babel Fish landing page on desktop"},
    {"src":"screenshot-mobile.png","sizes":"720x1280","type":"image/png","form_factor":"narrow","label":"Babel Fish landing page on a phone"}
  ],
  "shortcuts":[
    {"name":"Speak and translate","short_name":"Speak","description":"Open Babel Fish ready for voice input","url":"./?mode=speak","icons":[{"src":"icon-192.png","sizes":"192x192","type":"image/png"}]},
    {"name":"Type translation","short_name":"Type","description":"Open the text translator","url":"./?mode=type","icons":[{"src":"icon-192.png","sizes":"192x192","type":"image/png"}]},
    {"name":"Open Field Guide","short_name":"Guide","description":"Read the Babel Fish operating guide","url":"./?guide=1","icons":[{"src":"icon-192.png","sizes":"192x192","type":"image/png"}]}
  ],
  "share_target":{
    "action":"./?share=1",
    "method":"GET",
    "enctype":"application/x-www-form-urlencoded",
    "params":{"title":"title","text":"text","url":"url"}
  }
